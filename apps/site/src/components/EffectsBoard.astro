---
// 효과 일곱 개를 직접 눌러 보는 판. 컴퓨터에서는 키(C D A R M O X)를 누르고 있어도 된다.
// 화면은 첫 화면과 같은 맥북 렌더, 버튼 아이콘은 Microsoft Fluent Emoji 3D (MIT, public/icons/fx/LICENSE-fluentui-emoji.txt).
import Slide from './Slide.astro';
import { landing, type Cue } from '../i18n/landing';
import { CUE_KEYS } from '../scripts/cues';
import { MACBOOK } from '../data/devices';
import type { Lang } from '../site';
import '../styles/demo.css';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = landing[lang];
const keyOf = Object.fromEntries(Object.entries(CUE_KEYS).map(([k, c]) => [c, k.toUpperCase()])) as Record<Cue, string>;
const cues = Object.keys(t.cue) as Cue[];
const sounds = Object.fromEntries(cues.map((c) => [c, t.demo.sound(t.cue[c])]));
const end = t.demo.slides[4]!;
---

<div class="board" data-board data-sounds={JSON.stringify(sounds)}>
  <div class="board-screen">
    <div class="device device-mac" style={`aspect-ratio: ${MACBOOK.aspect}`} data-device>
      <span class="spill" aria-hidden="true"></span>
      <img class="device-img" src={MACBOOK.src} alt="" decoding="async" loading="lazy" draggable="false" />
      <div class="device-screen mac-screen" data-theme="dark" data-warp={JSON.stringify(MACBOOK.quad)} style={`width: ${MACBOOK.screen.w}px; height: ${MACBOOK.screen.h}px; border-radius: ${MACBOOK.screen.radiusTop}px ${MACBOOK.screen.radiusTop}px 0 0`}>
      <div class="screen slide-host">
        <Slide slide={end} index={4} />
        <canvas class="layer" data-cues aria-hidden="true"></canvas>
        <p class="cue-sound" data-sound hidden aria-live="polite">
          <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span data-sound-text></span>
        </p>
      </div>
      <span class="glass" aria-hidden="true"></span>
      </div>
    </div>
  </div>

  <p class="board-try">
    <span class="when-fine">{t.effects.try}</span>
    <span class="when-coarse">{t.effects.tryTouch}</span>
  </p>
  <div class="keys" role="group" aria-label={t.effects.title.join(' ')}>
    {
      cues.map((c) => (
        <button type="button" class="key" data-cue={c} aria-keyshortcuts={keyOf[c]}>
          <img class="key-icon" src={`/icons/fx/${c}.webp`} alt="" width="64" height="64" loading="lazy" draggable="false" />
          <span class="key-name">{t.cue[c]}</span>
          <kbd class="key-cap num">{keyOf[c]}</kbd>
          <i class="key-dot" aria-hidden="true" />
        </button>
      ))
    }
  </div>
  <p class="board-silent">{t.effects.silent}</p>
</div>

<script>
  import { initBoard } from '../scripts/board';
  import { mountWarp } from '../scripts/warp';
  document.querySelectorAll<HTMLElement>('[data-board] [data-warp]').forEach((el) => mountWarp(el.closest<HTMLElement>('[data-device]')!, el, JSON.parse(el.dataset.warp!)));
  document.querySelectorAll<HTMLElement>('[data-board]').forEach(initBoard);
</script>

<style>
  .board { margin-top: clamp(32px, 5vw, 48px); display: grid; justify-items: center; }
  .board-screen { width: 100%; max-width: 760px; }
  .board-try { margin-top: 32px; font-weight: 600; text-align: center; text-wrap: balance; }
  .when-coarse { display: none; }
  @media (pointer: coarse) {
    .when-fine { display: none; }
    .when-coarse { display: inline; }
  }
  .keys {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    /* 좁은 화면: 4개 + 3개 두 줄 (7개를 3개씩 놓으면 마지막 하나만 남는다) */
    max-width: 328px;
  }
  @media (min-width: 640px) { .keys { max-width: none; gap: 12px; } }
  .key {
    position: relative;
    width: 76px;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 6px;
    aspect-ratio: 0.86;
    padding-top: 6px;
    border-radius: var(--r-md);
    background: var(--bg-raised);
    box-shadow: inset 0 -3px 0 var(--surface-press), var(--shadow-raised);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    transition: transform 0.12s var(--ease-out), box-shadow 0.12s, background-color 0.12s;
  }
  .key:hover { background: var(--surface); }
  @media (min-width: 640px) { .key { width: 96px; } }
  .key-icon {
    width: 44px;
    height: 44px;
    pointer-events: none;
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.18));
    transition: transform 0.18s var(--ease-out);
  }
  @media (min-width: 640px) { .key-icon { width: 50px; height: 50px; } }
  .key:hover .key-icon { transform: translateY(-2px) scale(1.04); }
  .key.on .key-icon { transform: scale(0.94); }
  .key-name { font-size: 0.75rem; color: var(--fg-muted); line-height: 1.2; text-align: center; padding: 0 4px; }
  /* 단축키는 모서리에 작게 */
  .key-cap {
    position: absolute;
    top: 7px;
    left: 9px;
    font: inherit;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    color: var(--fg-muted);
  }
  .key-dot {
    position: absolute;
    top: 9px;
    right: 9px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--live);
    opacity: 0;
    transition: opacity 0.12s;
  }
  .key.on { transform: translateY(2px); background: var(--surface); box-shadow: inset 0 -1px 0 var(--surface-press); }
  .key.on .key-dot { opacity: 1; }
  .board-silent { margin-top: 20px; font-size: 0.875rem; color: var(--fg-muted); text-align: center; text-wrap: balance; }
</style>

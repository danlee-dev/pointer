---
// 제목을 구절 단위로 묶는다. 배열의 한 칸은 한 덩어리라서 좁은 화면에서도 구절 중간에서 줄이 바뀌지 않는다.
interface Props {
  text: string | readonly string[];
}
const { text } = Astro.props;
const parts = typeof text === 'string' ? [text] : text;
---

{parts.map((p, i) => (i === 0 ? <span class="phrase">{p}</span> : <> <span class="phrase">{p}</span></>))}

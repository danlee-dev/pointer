---
// 24px 선 아이콘. 색은 currentColor. 도구 아이콘 넷은 폰 리모컨(packages/remote-web/src/icons.tsx)과 같은 모양이다.
export type IconName =
  | 'laser'
  | 'spotlight'
  | 'magnify'
  | 'pen'
  | 'confetti'
  | 'drumroll'
  | 'applause'
  | 'fireworks'
  | 'micdrop'
  | 'correct'
  | 'wrong'
  | 'plus'
  | 'arrow';

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class={className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'laser' && (
      <>
        <circle cx="12" cy="12" r="3" fill="currentColor" stroke="none" />
        <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1" />
      </>
    )
  }
  {
    name === 'spotlight' && (
      <>
        <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" fill="currentColor" fill-opacity="0.28" stroke="none" />
        <circle cx="12" cy="12" r="4.5" fill="currentColor" stroke="none" />
      </>
    )
  }
  {name === 'magnify' && <path d="M15.5 15.5 21 21M8 10.5h5M10.5 8v5M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0z" />}
  {
    name === 'pen' && (
      <>
        <path d="M4 20l1-4.5L15.5 5a2.1 2.1 0 0 1 3 0l.5.5a2.1 2.1 0 0 1 0 3L8.5 19 4 20z" />
        <path d="M13.5 7l3.5 3.5" />
      </>
    )
  }
  {
    name === 'confetti' && (
      <>
        <path d="M4 20l4.6-11.2 6.6 6.6L4 20z" />
        <path d="M13 4.5l.8 1.6M19.5 11l-1.6.8M16.5 3.5v2M20.5 7.5h-2" />
        <circle cx="12.5" cy="9" r="0.9" fill="currentColor" stroke="none" />
        <circle cx="16" cy="13.5" r="0.9" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'drumroll' && (
      <>
        <ellipse cx="12" cy="11.5" rx="7.5" ry="2.6" />
        <path d="M4.5 11.5v5.2c0 1.4 3.4 2.6 7.5 2.6s7.5-1.2 7.5-2.6v-5.2" />
        <path d="M8 13.8v4.6M16 13.8v4.6M5 3.5l5.5 6M19 3.5l-5.5 6" />
      </>
    )
  }
  {
    name === 'applause' && (
      <>
        <path d="M9.5 20.5c-2.6-1.2-4.4-3.8-4.4-6.8V9.4a1.4 1.4 0 0 1 2.8 0v2.4M7.9 11.8V6.6a1.4 1.4 0 0 1 2.8 0v4.6M10.7 11.2V5.4a1.4 1.4 0 0 1 2.8 0v5.8M13.5 11.2V7.6a1.4 1.4 0 0 1 2.8 0v5.6c0 3.3-2 6-4.8 7.3" />
        <path d="M18.5 4.5l1.5-1.5M19.5 8h2M17 2v1.5" />
      </>
    )
  }
  {
    name === 'fireworks' && (
      <>
        <path d="M12 12V3M12 12l6.4-6.4M12 12h9M12 12l6.4 6.4M12 12v9M12 12l-6.4 6.4M12 12H3M12 12L5.6 5.6" stroke-dasharray="0 3.2 6 20" />
        <circle cx="12" cy="12" r="1.3" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'micdrop' && (
      <>
        <circle cx="15.5" cy="8.5" r="3.6" />
        <path d="M13 11.2L5 19.5a1.5 1.5 0 0 0 2.1 2.1l8.2-8" />
        <path d="M13.2 6.4l4.4 4.4M3 4.5l2 1M2.5 9h2.2M6.5 2.5l.6 2" />
      </>
    )
  }
  {name === 'correct' && <circle cx="12" cy="12" r="7.5" stroke-width="2.6" />}
  {name === 'wrong' && <path d="M6 6l12 12M18 6L6 18" stroke-width="2.6" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
</svg>

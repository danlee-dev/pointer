---
// 다운로드 버튼 줄. site.ts 에 링크가 있는 플랫폼만 버튼이 되고, 없는 것은 "곧 공개" 한 줄로 묶는다.
// 첫 번째 버튼만 잉크 알약(한 화면에 하나), 나머지는 보조 알약.
import { site, type Lang } from '../site';
import { landing, type Platform } from '../i18n/landing';
import appIcon from '../../../../brand/logo/icon-small.svg?url';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = landing[lang].download;

const links: Record<Platform, string | null> = {
  mac: site.downloads.mac,
  windows: site.downloads.windows,
  ios: site.appStore,
};
const order: Platform[] = ['mac', 'windows', 'ios'];
const ready = order.filter((p) => links[p]);
const soon = order.filter((p) => !links[p]).map((p) => t.names[p]);
---

<div class="downloads">
  {
    ready.length > 0 && (
      <div class="dl-row">
        {ready.map((p, i) => (
          <a class:list={['pill', i === 0 ? 'pill-primary' : 'pill-secondary']} href={links[p]!} data-platform={p}>
            {i === 0 && <img class="pill-icon" src={appIcon} alt="" width="26" height="26" />}
            {t[p]}
          </a>
        ))}
      </div>
    )
  }
  {soon.length > 0 && <p class="dl-soon">{t.soon(soon)}</p>}
</div>

<style>
  .downloads { display: grid; gap: 14px; justify-items: start; }
  .dl-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .dl-soon {
    display: inline-flex;
    align-items: flex-start;
    gap: 10px;
    font-weight: 600;
    color: var(--fg);
  }
  /* 아직 받을 수 없다는 표시. 빨강은 "지금 나가는 중" 이라 쓰지 않고 잉크 점 테두리만 */
  .dl-soon::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    /* 첫 줄 가운데 (줄 높이 1.6em) */
    margin-top: calc(0.8em - 4px);
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--fg-muted);
  }
</style>

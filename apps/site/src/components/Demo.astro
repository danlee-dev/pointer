---
// 첫 화면 데모: 맥북(청중 화면)과 아이폰(리모컨). 기기는 3D 모델을 렌더링한 이미지이고,
// 그 화면 자리에 진짜로 움직이는 HTML 화면을 원근에 맞춰 얹는다 (scripts/warp.ts).
// 폰 패드를 누른 채 움직이면 레이저·스포트라이트·돋보기·펜이 맥북 화면에 나타나고, 다음을 누르면 장이 넘어간다.
// 화면 안은 페이지 테마와 상관없이 어둡게 고정한다 (DESIGN.md).
import Slide from './Slide.astro';
import Icon from './Icon.astro';
import { landing, type Cue, type Tool } from '../i18n/landing';
import { IPHONE, MACBOOK } from '../data/devices';
import type { Lang } from '../site';
import '../styles/demo.css';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = landing[lang];
const slides = t.demo.slides;
const tools: Tool[] = ['laser', 'spotlight', 'magnify', 'pen'];
const phoneCues: Cue[] = ['confetti', 'drumroll', 'correct'];
const pens = ['red', 'yellow', 'blue', 'white'] as const;
const allCues = Object.keys(t.cue) as Cue[];
const sounds = Object.fromEntries(allCues.map((c) => [c, t.demo.sound(t.cue[c])]));
---

<div class="stage" data-theme="dark" data-demo data-sounds={JSON.stringify(sounds)} data-next={t.demo.next} data-last={t.demo.last}>
  <!-- 무대 조명: 위에서 떨어지는 은은한 빛 (DESIGN.md "무대") -->
  <div class="lights" aria-hidden="true">
    <span class="top-light"></span>
  </div>

  <div class="stage-grid" role="group" aria-label={t.demo.label}>
    <div class="screen-wrap">
      <div class="device device-mac" style={`aspect-ratio: ${MACBOOK.aspect}`} data-device>
        <span class="spill" aria-hidden="true"></span>
        <img class="device-img" src={MACBOOK.src} alt="" decoding="async" fetchpriority="high" draggable="false" />
        <div class="device-screen mac-screen" data-warp={JSON.stringify(MACBOOK.quad)} style={`width: ${MACBOOK.screen.w}px; height: ${MACBOOK.screen.h}px; border-radius: ${MACBOOK.screen.radiusTop}px ${MACBOOK.screen.radiusTop}px ${MACBOOK.screen.radiusBottom}px ${MACBOOK.screen.radiusBottom}px`}>
        <div class="screen slide-host" data-screen>
          {slides.map((s, i) => <Slide slide={s} index={i} hidden={i !== 0} />)}
          <canvas class="layer" data-ink aria-hidden="true"></canvas>
          <div class="layer spot" data-spot hidden></div>
          <div class="lens" data-lens hidden>
            <div class="lens-host slide-host" data-lens-host></div>
          </div>
          <canvas class="layer" data-laser aria-hidden="true"></canvas>
          <canvas class="layer" data-cues aria-hidden="true"></canvas>
          <p class="cue-sound" data-sound hidden aria-live="polite">
            <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span data-sound-text></span>
          </p>
        </div>
        </div>
      </div>
    </div>

    <div class="device device-phone" style={`aspect-ratio: ${IPHONE.aspect}`} data-device>
      <span class="spill" aria-hidden="true"></span>
      <img class="device-img" src={IPHONE.src} alt="" decoding="async" draggable="false" />
      <div class="device-screen phone-screen" data-warp={JSON.stringify(IPHONE.quad)} style={`width: ${IPHONE.screen.w}px; height: ${IPHONE.screen.h}px; border-radius: ${IPHONE.screen.radiusTop}px ${IPHONE.screen.radiusTop}px ${IPHONE.screen.radiusBottom}px ${IPHONE.screen.radiusBottom}px`}>
        <span class="island" aria-hidden="true"></span>
        <div class="r-bar">
          <p class="r-page num" aria-live="polite"><b data-page>1</b><span>/ {slides.length}</span></p>
          <p class="r-clock num" data-clock>0:00</p>
        </div>

        <div class="r-pad slide-host" data-pad>
          {slides.map((s, i) => <Slide slide={s} index={i} hidden={i !== 0} />)}
          <canvas class="layer" data-pad-ink aria-hidden="true"></canvas>
          <span class="r-finger" data-finger hidden></span>
          <p class="r-hint" data-hint>{t.demo.hint.laser}</p>
        </div>

        <div class="r-tools" role="radiogroup" aria-label={lang === 'ko' ? '도구' : 'Tools'}>
          {
            tools.map((k) => (
              <button
                type="button"
                class="r-tool"
                role="radio"
                aria-checked={k === 'laser' ? 'true' : 'false'}
                data-tool={k}
                data-hint={t.demo.hint[k]}
              >
                <Icon name={k} />
                <span>{t.demo.tool[k]}</span>
              </button>
            ))
          }
        </div>

        <div class="r-pens" data-pens hidden>
          {
            pens.map((c, i) => (
              <button
                type="button"
                class={`r-swatch swatch-${c}`}
                data-pen={c}
                aria-label={t.demo.pens[c]}
                aria-pressed={i === 0 ? 'true' : 'false'}
              />
            ))
          }
          <button type="button" class="r-clear" data-clear>{t.demo.clear}</button>
        </div>

        <div class="r-cues">
          {
            phoneCues.map((c) => (
              <button type="button" class="r-cue" data-cue={c}>
                <Icon name={c} />
                <span>{t.cue[c]}</span>
              </button>
            ))
          }
        </div>

        <div class="r-nav">
          <button type="button" class="r-prev" data-prev disabled>{t.demo.prev}</button>
          <button type="button" class="r-next" data-next-btn>
            <span class="r-thumb slide-host" data-next-thumb aria-hidden="true">
              {slides.map((s, i) => <Slide slide={s} index={i} hidden={i !== 1} />)}
            </span>
            <span class="r-next-label" data-next-label>{t.demo.next}</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <p class="stage-caption">{t.hero.caption}</p>
</div>

<script>
  import { initDemo } from '../scripts/demo';
  import { mountWarp } from '../scripts/warp';
  // 화면을 먼저 기기 위에 얹고 나서 데모를 켠다 (캔버스 크기를 얹은 뒤 기준으로 잰다)
  document.querySelectorAll<HTMLElement>('[data-warp]').forEach((el) => mountWarp(el.closest<HTMLElement>('[data-device]')!, el, JSON.parse(el.dataset.warp!)));
  document.querySelectorAll<HTMLElement>('[data-demo]').forEach(initDemo);

</script>

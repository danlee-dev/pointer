{
  "name": "@pointer/desktop",
  "productName": "pointer",
  "version": "0.1.0",
  "description": "폰으로 넘기는 발표 리모컨",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "predev": "node scripts/copy-pdfjs-assets.mjs && node scripts/build-native.mjs",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs && node scripts/build-native.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.22.0",
    "fflate": "^0.8.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@pointer/design": "workspace:*",
    "@pointer/i18n": "workspace:*",
    "@pointer/protocol": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pdfjs-dist": "^6.4.299",
    "pretendard": "^1.3.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "author": "danlee-dev"
}

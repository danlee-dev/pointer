{
  "expo": {
    "name": "pointer",
    "slug": "pointer",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0c0a09",
    "splash": { "backgroundColor": "#0c0a09" },
    "ios": {
      "bundleIdentifier": "dev.danlee.pointer",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "같은 와이파이에 있는 컴퓨터의 pointer 앱과 연결해서 발표를 넘기려면 로컬 네트워크 접근이 필요합니다.",
        "NSMotionUsageDescription": "에어 포인터: 폰을 움직여 화면의 레이저를 옮길 때 움직임 센서를 씁니다.",
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "컴퓨터의 pointer 앱에 뜬 QR 코드를 찍어서 연결합니다.", "microphonePermission": false, "recordAudioAndroid": false }]
    ]
  }
}
